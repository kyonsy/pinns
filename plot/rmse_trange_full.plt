# ============================================================================
# 学習区間の長さと, 学習区間全体 [0,T] における RMSE の関係を描くスクリプト (ζ=0)
#
# 入力: out/rmse_trange_full.dat  ← script/analyse_error_trange_full.py の出力
#       2列のデータ: 1列目 学習区間の終端 T (学習区間は [0,T]), 2列目 RMSE
# 出力: graph/rmse_trange_full.png
# 実行: plot/ フォルダで  gnuplot rmse_trange_full.plt
#       (他の .plt と同じく, ファイルのパスは plot/ から見た相対パス)
# ============================================================================


# ----------------------------------------------------------------------------
# タイトルと軸ラベル
# ----------------------------------------------------------------------------
set title "RMSE on [0,T] vs training range (ζ=0)"
set xlabel "training range T  ([0,T])"
set ylabel "RMSE"


# ----------------------------------------------------------------------------
# x軸の目盛り: π ごとに "π", "2π", ... と表示する
# ----------------------------------------------------------------------------
# 書式 '%.0Pπ' だと "0π", "1π" になってしまうので, 目盛りの文字を1つずつ指定する
#   ("文字" 位置) で, その位置にその文字の目盛りを打つ. "add" で追加していく
set xrange [0:10.5*pi]
set xtics ("0" 0, "π" pi)
set for [k=2:10] xtics add (sprintf("%dπ", k) k*pi)
set mxtics 2


# ----------------------------------------------------------------------------
# y軸は対数目盛り (RMSE は桁が大きく変わるため)
# ----------------------------------------------------------------------------
set logscale y
set format y '10^{%L}'


# ----------------------------------------------------------------------------
# 見た目
# ----------------------------------------------------------------------------
set linetype 1 lc rgb "#1f77b4" lw 2 pt 7 ps 1.2
set grid xtics ytics mxtics
unset key


# ----------------------------------------------------------------------------
# 出力先の設定
# ----------------------------------------------------------------------------
set terminal pngcairo enhanced size 900,500
set output "../graph/rmse_trange_full.png"


# ----------------------------------------------------------------------------
# 描画
# ----------------------------------------------------------------------------
#   using 1:2         : 1列目を x (T), 2列目を y (RMSE) として使う
#   with linespoints  : 各点に印を付けて線でつなぐ (学習区間ごとの離散データなので)
plot "../out/rmse_trange_full.dat" using 1:2 with linespoints

set output
