# ============================================================================
# 学習区間の長さと, [0,2π] における RMSE の関係を描くスクリプト (ζ=0)
#
# 入力: out/rmse_trange.dat  ← script/analyse_error_trange.py の出力
#       2列のデータ: 1列目 学習区間の終端 T (学習区間は [0,T]), 2列目 RMSE
# 出力: graph/rmse_trange.png
# 実行: plot/ フォルダで  gnuplot rmse_trange.plt
#       (他の .plt と同じく, ファイルのパスは plot/ から見た相対パス)
# ============================================================================


# ----------------------------------------------------------------------------
# タイトルと軸ラベル
# ----------------------------------------------------------------------------
set title "RMSE on [0,2π] vs training range (ζ=0)"
set xlabel "training range T  ([0,T])"
set ylabel "RMSE"


# ----------------------------------------------------------------------------
# x軸の目盛り: π ごとに "2π", "3π", ... と表示する
# ----------------------------------------------------------------------------
# %.0P : 値を π で割った数を整数で表示 (例: 6.28... → "2")
set xrange [1.5*pi:10.5*pi]
set xtics pi
set mxtics 2
set format x '%.0Pπ'


# ----------------------------------------------------------------------------
# y軸は対数目盛り (RMSE は 10^-3 〜 10^-1 と桁が変わるため)
# ----------------------------------------------------------------------------
set logscale y
set format y '10^{%L}'


# ----------------------------------------------------------------------------
# 見た目
# ----------------------------------------------------------------------------
set linetype 1 lc rgb "#1f77b4" lw 2 pt 7 ps 1.2
set grid xtics ytics mxtics
unset key


# ----------------------------------------------------------------------------
# 出力先の設定
# ----------------------------------------------------------------------------
set terminal pngcairo enhanced size 900,500
set output "../graph/rmse_trange.png"


# ----------------------------------------------------------------------------
# 描画
# ----------------------------------------------------------------------------
#   using 1:2         : 1列目を x (T), 2列目を y (RMSE) として使う
#   with linespoints  : 各点に印を付けて線でつなぐ (学習区間ごとの離散データなので)
plot "../out/rmse_trange.dat" using 1:2 with linespoints

set output
