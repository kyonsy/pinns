# ============================================================================
# 学習区間ごとの PINN と解析解の誤差 |y_pinn - y_exact| を描くスクリプト (ζ=0)
#
# 入力: out/out<j>.dat  ← script/dump_sys_trange.py の出力
#       j 番目のファイルは学習区間 [0, jπ/4) で学習した結果
#       各ファイルは4列のデータ: 1列目 t, 2列目 pinn, 3列目 exact, 4列目 abs_err
#       (先頭の "# t pinn exact abs_err" の行は, # で始まるので gnuplot は読み飛ばす)
# 出力: graph/error_trange.png
# 実行: プロジェクトルート(pinns/)で  gnuplot plot/error_trange.plt
#       ※ ファイルのパスはすべて「実行した場所」からの相対パスなので,
#         必ずプロジェクトルートで実行すること
#
# gnuplot の基本:
#   - "#" から行末まではコメント (実行されない)
#   - "set ○○" でグラフの設定を変え, 最後に "plot" で実際に描く
#   - 設定は plot より前に書く必要がある (plot した後の set は, その plot に反映されない)
# ============================================================================

set xrange [0:5*pi]
# ----------------------------------------------------------------------------
# 変数の定義
# ----------------------------------------------------------------------------
# 「変数名 = 値」で変数を作れる. ここでは読み込むファイルの数 (out1.dat 〜 outN.dat)
# ※ dump_sys_trange.py のループ回数と必ず揃えること
#   (大きすぎると存在しないファイルを読もうとしてエラー)
N = 20


# ----------------------------------------------------------------------------
# タイトルと軸ラベル
# ----------------------------------------------------------------------------
# グラフの上部中央に表示するタイトル
set title "PINN error vs training range (ζ=0)"

# x軸(横軸)の名前
set xlabel "t"

# y軸(縦軸)の名前
# "_{...}" は下付き文字. 下の "set terminal ... enhanced" を指定しているので有効になる
# (enhanced なしだと "_{PINN}" がそのまま文字として表示される)
set ylabel "|y_{PINN} - y_{exact}|"


# ----------------------------------------------------------------------------
# x軸の目盛り
# ----------------------------------------------------------------------------
# x軸の範囲 (set xrange) はあえて指定していない
# → 学習区間がファイルごとに違うので, データの範囲から自動で決めさせる

# 目盛り(数字が書かれる大きな目盛り)の間隔. ここでは π/4 ごとに目盛りを打つ
# pi は gnuplot に組み込みの円周率
set xtics pi/2

# 目盛りの数字の書式. C言語の printf に近い書き方
#   %.2P : 値を π で割った数を, 小数点以下2桁で表示する (P は gnuplot 独自の「π単位」指定)
#   π    : その後ろにそのまま "π" の文字を付ける
#   例: 値が 0.785...(=π/4) なら "0.25π" と表示される
set format x '%.2Pπ'


# ----------------------------------------------------------------------------
# y軸を対数目盛りにする
# ----------------------------------------------------------------------------
# y軸を対数目盛り(10倍ごとに等間隔)にする
# 誤差は 10^-1 〜 10^-7 のように桁が大きく変わるので, 普通の目盛りだと小さい誤差が潰れて見えない
# ※ 対数目盛りでは 0 以下の値は描けない (その点は自動で飛ばされる)
set logscale y

# y軸の目盛りの書式
#   %L     : 値の「10の何乗か」の指数部分 (例: 0.001 なら -3)
#   10^{..} : enhanced モードの上付き文字. "10^{-3}" は 10 の右上に小さく -3 と表示される
set format y '10^{%L}'


# ----------------------------------------------------------------------------
# 線の色と太さ
# ----------------------------------------------------------------------------
# plot で複数の線を描くと, 1本目は linetype 1, 2本目は linetype 2, ... と順に使われる
# ここでは各 linetype の見た目を上書きしている
#   lc rgb "#1f77b4" : 線の色 (line color). "#RRGGBB" の16進数で赤・緑・青の強さを指定
#   lw 2             : 線の太さ (line width). 1 が標準
# gnuplot 既定の5色目は薄い黄色で見えにくいため, 見分けやすい色に変えている
set linetype 1 lc rgb "#1f77b4" lw 2
set linetype 2 lc rgb "#ff7f0e" lw 2
set linetype 3 lc rgb "#2ca02c" lw 2
set linetype 4 lc rgb "#d62728" lw 2
set linetype 5 lc rgb "#9467bd" lw 2

# 6本目以降は, また linetype 1 の色から繰り返して使う (N を6以上にしたとき用)
set linetype cycle 5


# ----------------------------------------------------------------------------
# グリッド線と凡例
# ----------------------------------------------------------------------------
# グラフの背景に格子状の補助線(グリッド)を引く
#   xtics : x軸の目盛りの位置に縦線を引く
#   ytics : y軸の目盛りの位置に横線を引く
set grid xtics ytics

# 凡例(どの線が何を表すかの一覧. gnuplot では key と呼ぶ)の位置
#   outside : グラフの枠の外に置く (線と重ならないように)
#   right   : 右側に置く
set key outside right


# ----------------------------------------------------------------------------
# 出力先の設定
# ----------------------------------------------------------------------------
# 出力形式(terminal)の指定. 何も指定しないと画面上のウィンドウに表示される
#   pngcairo      : PNG画像として出力する (cairo という描画ライブラリを使うので線がきれい)
#   enhanced      : 上付き・下付き文字 (^{..}, _{..}) を使えるようにする
#   size 900,500  : 画像のサイズ (横900ピクセル, 縦500ピクセル)
set terminal pngcairo enhanced size 1600,500

# 出力するファイル名. graph/ フォルダは事前に存在している必要がある
set output "../graph/error_trange.png"


# ----------------------------------------------------------------------------
# 描画
# ----------------------------------------------------------------------------
# plot コマンドの各部分の意味:
#   for [j=1:N]                  : j を 1, 2, ..., N と変えながら繰り返す (学習区間ごとに1本ずつ線を描く)
#   sprintf("out/out%d.dat",j)   : 読み込むファイル名を作る. %d の部分に整数 j が入る
#                                  例: j が 2 なら "out/out2.dat" になる
#   using 1:4                    : ファイルの1列目を x (t), 4列目を y (abs_err) として使う
#   with lines                   : 点を線でつないで描く (with points なら点だけ)
#   title sprintf("[0,%dπ/4)",j) : 凡例に表示する名前. 例: j が 2 なら "[0,2π/4)"
plot for [j=1:N:4] sprintf("../out/out%d.dat",j) using 1:4 with lines title sprintf("[0,%dπ/4)",j)

# 出力先を閉じる. これで PNG ファイルへの書き込みが確定する
# (書かないと, 環境によってはファイルが不完全なまま残ることがある)
set output
