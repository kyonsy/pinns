# ============================================================================
# 減衰比ζごとの PINN の出力と解析解を重ねて描くスクリプト
# 実線: PINN, 破線: 解析解 (同じζは同じ色)
#
# 入力: out/zeta<ζ>.dat  ← script/dump_sys_zeta.py の出力
#       各ファイルは4列のデータ: 1列目 t, 2列目 pinn, 3列目 exact, 4列目 abs_err
#       (先頭の "# t pinn exact abs_err" の行は, # で始まるので gnuplot は読み飛ばす)
# 出力: graph/solution_zeta.png
# 実行: プロジェクトルート(pinns/)で  gnuplot plot/solution_zeta.plt
#       ※ ファイルのパスはすべて「実行した場所」からの相対パスなので,
#         必ずプロジェクトルートで実行すること
#
# gnuplot の基本:
#   - "#" から行末まではコメント (実行されない)
#   - "set ○○" でグラフの設定を変え, 最後に "plot" で実際に描く
#   - 設定は plot より前に書く必要がある (plot した後の set は, その plot に反映されない)
# ============================================================================


# ----------------------------------------------------------------------------
# 変数の定義
# ----------------------------------------------------------------------------
# 「変数名 = 値」で変数を作れる. ここでは描きたいζの値を, 空白区切りの文字列で持っておく
# 下の plot で words(zetas) (単語の数 = 5) や word(zetas,i) (i 番目の単語) として取り出す
# ※ dump_sys_zeta.py の zetas と必ず揃えること (ずれると存在しないファイルを読もうとしてエラー)
zeta_max = 2

# ----------------------------------------------------------------------------
# タイトルと軸ラベル
# ----------------------------------------------------------------------------
# グラフの上部中央に表示するタイトル
set title "PINN solution vs exact solution"

# x軸(横軸)の名前
set xlabel "t"

# y軸(縦軸)の名前
set ylabel "y"


# ----------------------------------------------------------------------------
# 軸の範囲と目盛り
# ----------------------------------------------------------------------------
# x軸に表示する範囲を [最小値:最大値] で指定する. pi は gnuplot に組み込みの円周率
# 指定しないとデータの範囲から自動で決まる (キリの良い値に広げられることがある)
set xrange [0:2*pi]

# y軸に表示する範囲. 解は -1 〜 1 の間に収まるので, 少し余裕を持たせている
# (PINN の出力が範囲外に大きく外れた場合, その部分はグラフの外に切れて見えなくなる)
set yrange [-1.1:1.1]

# x軸の目盛り(数字が書かれる大きな目盛り)の間隔. ここでは π/2 ごとに目盛りを打つ
set xtics pi/2

# 目盛りの数字の書式. C言語の printf に近い書き方
#   %.1P : 値を π で割った数を, 小数点以下1桁で表示する (P は gnuplot 独自の「π単位」指定)
#   π    : その後ろにそのまま "π" の文字を付ける
#   例: 値が 1.5707...(=π/2) なら "0.5π" と表示される
set format x '%.1Pπ'

# 補助目盛り(数字の書かれない小さな目盛り)の数. 大きな目盛りの間を2分割する
# → π/4 ごとに小さな目盛りが入る
set mxtics 2


# ----------------------------------------------------------------------------
# 線の色
# ----------------------------------------------------------------------------
# 使う色を空白区切りの文字列で持っておき, plot で word(colors,i) として i 番目を取り出す
# "#RRGGBB" は16進数で赤・緑・青の強さを表す色の指定
# (PINN の線と解析解の線を同じ色にしたいので, set linetype ではなくこの方法で色を指定している)
# gnuplot 既定の5色目は薄い黄色で見えにくいため, 見分けやすい色にしている
# ※ ζを6個以上に増やす場合は, ここにも色を追加すること
colors = "#1f77b4 #ff7f0e #2ca02c #d62728 #9467bd"
color(j)=word(colors,(j-1)%words(colors)+1)

# ----------------------------------------------------------------------------
# グリッド線と凡例
# ----------------------------------------------------------------------------
# グラフの背景に格子状の補助線(グリッド)を引く
#   xtics  : x軸の大きな目盛りの位置に縦線を引く
#   mxtics : x軸の小さな目盛りの位置にも縦線を引く
#   ytics  : y軸の目盛りの位置に横線を引く
set grid xtics mxtics ytics

# 凡例(どの線が何を表すかの一覧. gnuplot では key と呼ぶ)の位置
#   outside : グラフの枠の外に置く (線と重ならないように)
#   right   : 右側に置く
set key outside right


# ----------------------------------------------------------------------------
# 出力先の設定
# ----------------------------------------------------------------------------
# 出力形式(terminal)の指定. 何も指定しないと画面上のウィンドウに表示される
#   pngcairo      : PNG画像として出力する (cairo という描画ライブラリを使うので線がきれい)
#   enhanced      : 上付き・下付き文字 (^{..}, _{..}) を使えるようにする
#   size 900,500  : 画像のサイズ (横900ピクセル, 縦500ピクセル)
set terminal pngcairo enhanced size 900,500

# 出力するファイル名. graph/ フォルダは事前に存在している必要がある
set output "../graph/solution_zeta.png"


# ----------------------------------------------------------------------------
# 描画
# ----------------------------------------------------------------------------
# 1つの plot コマンドで, カンマ区切りで3種類の線を描いている
# 行末の "\" は「次の行に続く」という意味 (長いコマンドを複数行に分けるため)
# ※ "\" で続けている途中の行にはコメントを書けないので, 説明はここにまとめて書く
#
# [1つ目] PINN の出力 (実線)
#   for [i=1:words(zetas)]         : i を 1 〜 5 (ζの個数) と変えながら繰り返す
#   "out/zeta".word(zetas,i).".dat": 読み込むファイル名. "." は文字列の連結, word(zetas,i) は i 番目のζ
#                                    例: i が 2 なら "out/zeta0.5.dat" になる
#   using 1:2                      : ファイルの1列目を x (t), 2列目を y (pinn) として使う
#   with lines                     : 点を線でつないで描く
#   lw 2                           : 線の太さ (line width) を 2 にする
#   lc rgb word(colors,i)          : 線の色 (line color) を colors の i 番目にする
#   title "PINN ζ=".word(zetas,i)  : 凡例に表示する名前. 例: "PINN ζ=0.5"
#
# [2つ目] 解析解 (破線)
#   using 1:3                      : 1列目を x (t), 3列目を y (exact) として使う
#   lw 1                           : 線の太さを 1 (細め) にする
#   dt 2                           : 線の種類 (dash type). 1 が実線, 2 が破線
#   lc rgb word(colors,i)          : PINN と同じ色にする (どの線同士を比べるか分かるように)
#   notitle                        : 凡例に表示しない (5本並ぶと凡例が長くなるため)
#
# [3つ目] 凡例用のダミー
#   NaN                            : 「値なし」. 何も描かれない線になる
#   dt 2 lc rgb "black"            : 黒の破線
#   title "exact"                  : 凡例に「exact ---」とだけ1行表示させるために使っている
plot for [i=zeta_max*10:0:-1] \
     sprintf("../out/zeta%2.1f.dat",i*0.1) using 1:2 \
         with lines lw 2 lc rgb color(i+1) title sprintf("PINN ζ=%2.1f",i*0.1), \
     sprintf("../out/zeta%2.1f.dat",zeta_max) using 1:3 \
         with lines lw 1 dt 2 lc rgb "black" notitle, \
     NaN with lines lw 1 dt 2 lc rgb "black" title "exact"

# 出力先を閉じる. これで PNG ファイルへの書き込みが確定する
# (書かないと, 環境によってはファイルが不完全なまま残ることがある)
set output
