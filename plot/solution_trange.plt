# ============================================================================
# 学習区間ごとの PINN の出力と解析解を重ねて描くスクリプト (ζ=0)
# 実線: PINN, 破線: 解析解 (同じ学習区間は同じ色)
#
# 入力: out/out<j>.dat  ← script/dump_sys_trange.py の出力
#       j 番目のファイルは学習区間 [0, jπ/4) で学習した結果
#       各ファイルは4列のデータ: 1列目 t, 2列目 pinn, 3列目 exact, 4列目 abs_err
#       (先頭の "# t pinn exact abs_err" の行は, # で始まるので gnuplot は読み飛ばす)
# 出力: graph/solution_trange.png
# 実行: プロジェクトルート(pinns/)で  gnuplot plot/solution_trange.plt
#       ※ ファイルのパスはすべて「実行した場所」からの相対パスなので,
#         必ずプロジェクトルートで実行すること
#
# gnuplot の基本:
#   - "#" から行末まではコメント (実行されない)
#   - "set ○○" でグラフの設定を変え, 最後に "plot" で実際に描く
#   - 設定は plot より前に書く必要がある (plot した後の set は, その plot に反映されない)
# ============================================================================


# ----------------------------------------------------------------------------
# 変数の定義
# ----------------------------------------------------------------------------
# 「変数名 = 値」で変数を作れる. ここでは読み込むファイルの数 (out1.dat 〜 outN.dat)
# ※ dump_sys_trange.py のループ回数と必ず揃えること
#   (大きすぎると存在しないファイルを読もうとしてエラー)
N = 10


# ----------------------------------------------------------------------------
# タイトルと軸ラベル
# ----------------------------------------------------------------------------
# グラフの上部中央に表示するタイトル
set title "PINN solution vs exact solution (ζ=0)"

# x軸(横軸)の名前
set xlabel "t"

# y軸(縦軸)の名前
set ylabel "y"


# ----------------------------------------------------------------------------
# 軸の範囲と目盛り
# ----------------------------------------------------------------------------
# x軸の範囲 (set xrange) はあえて指定していない
# → 学習区間がファイルごとに違うので, データの範囲から自動で決めさせる

# y軸に表示する範囲. 解は -1 〜 1 の間に収まるので, 少し余裕を持たせている
# (PINN の出力が範囲外に大きく外れた場合, その部分はグラフの外に切れて見えなくなる)
set yrange [-1.1:1.1]

# x軸の目盛り(数字が書かれる大きな目盛り)の間隔. ここでは π/4 ごとに目盛りを打つ
# pi は gnuplot に組み込みの円周率
set xtics pi/2

# 目盛りの数字の書式. C言語の printf に近い書き方
#   %.2P : 値を π で割った数を, 小数点以下2桁で表示する (P は gnuplot 独自の「π単位」指定)
#   π    : その後ろにそのまま "π" の文字を付ける
#   例: 値が 0.785...(=π/4) なら "0.25π" と表示される
set format x '%.2Pπ'

set mxtics 2
# ----------------------------------------------------------------------------
# 線の色
# ----------------------------------------------------------------------------
# 使う色を空白区切りの文字列で持っておく
# "#RRGGBB" は16進数で赤・緑・青の強さを表す色の指定
# (PINN の線と解析解の線を同じ色にしたいので, set linetype ではなくこの方法で色を指定している)
# gnuplot 既定の5色目は薄い黄色で見えにくいため, 見分けやすい色にしている

colors = "#1f77b4 #ff7f0e #2ca02c #d62728 #9467bd #000099"

# j 番目の線の色を返す関数. 「関数名(引数) = 式」で自分で関数を定義できる
#   words(colors)              : colors に含まれる色の数 (= 5)
#   (j-1)%words(colors)+1      : j を 1〜5 の範囲に折り返した番号. % は割り算の余り
#                                例: j=1→1, j=5→5, j=6→1, j=7→2 (6本目以降は最初の色から繰り返す)
#   word(colors, 番号)         : colors のその番号の色を取り出す

# color(j) = sprintf("#%06d",99+(111100*j)%1000000)
color(j) = word(colors,(j-1)%words(colors)+1)

# ----------------------------------------------------------------------------
# グリッド線と凡例
# ----------------------------------------------------------------------------
# グラフの背景に格子状の補助線(グリッド)を引く
#   xtics : x軸の目盛りの位置に縦線を引く
#   ytics : y軸の目盛りの位置に横線を引く
set grid xtics ytics

# 凡例(どの線が何を表すかの一覧. gnuplot では key と呼ぶ)の位置
#   outside : グラフの枠の外に置く (線と重ならないように)
#   right   : 右側に置く
set key outside right


# ----------------------------------------------------------------------------
# 出力先の設定
# ----------------------------------------------------------------------------
# 出力形式(terminal)の指定. 何も指定しないと画面上のウィンドウに表示される
#   pngcairo      : PNG画像として出力する (cairo という描画ライブラリを使うので線がきれい)
#   enhanced      : 上付き・下付き文字 (^{..}, _{..}) を使えるようにする
#   size 900,500  : 画像のサイズ (横900ピクセル, 縦500ピクセル)
set terminal pngcairo enhanced size 1600,500

# 出力するファイル名. graph/ フォルダは事前に存在している必要がある
set output "../graph/solution_trange.png"


# ----------------------------------------------------------------------------
# 描画
# ----------------------------------------------------------------------------
# 1つの plot コマンドで, カンマ区切りで3種類の線を描いている
# 行末の "\" は「次の行に続く」という意味 (長いコマンドを複数行に分けるため)
# ※ "\" で続けている途中の行にはコメントを書けないので, 説明はここにまとめて書く
#
# [1つ目] PINN の出力 (実線)
#   for [j=1:N]                       : j を 1, 2, ..., N と変えながら繰り返す (学習区間ごとに1本ずつ)
#   sprintf("out/out%d.dat",j)        : 読み込むファイル名を作る. %d の部分に整数 j が入る
#                                       例: j が 2 なら "out/out2.dat" になる
#   using 1:2                         : ファイルの1列目を x (t), 2列目を y (pinn) として使う
#   with lines                        : 点を線でつないで描く
#   lw 2                              : 線の太さ (line width) を 2 にする
#   lc rgb color(j)                   : 線の色 (line color) を, 上で定義した関数 color(j) の色にする
#   title sprintf("PINN [0,%dπ/4)",j) : 凡例に表示する名前. 例: j が 2 なら "PINN [0,2π/4)"
#
# [2つ目] 解析解 (破線)
#   using 1:3                         : 1列目を x (t), 3列目を y (exact) として使う
#   lw 1                              : 線の太さを 1 (細め) にする
#   dt 2                              : 線の種類 (dash type). 1 が実線, 2 が破線
#   lc rgb color(j)                   : PINN と同じ色にする (どの線同士を比べるか分かるように)
#   notitle                           : 凡例に表示しない (本数が増えると凡例が長くなるため)
#
# [3つ目] 凡例用のダミー
#   NaN                               : 「値なし」. 何も描かれない線になる
#   dt 2 lc rgb "black"               : 黒の破線
#   title "exact"                     : 凡例に「exact ---」とだけ1行表示させるために使っている
plot for [j=N:1:-1] sprintf("../out/out%d.dat",j) using 1:2 \
         with lines lw 2 lc rgb color(j) title sprintf("PINN [0,%dπ/4)",j), \
     sprintf("../out/out%d.dat",N) using 1:3 \
         with lines lw 1 dt 2 lc rgb "#50000000" notitle, \
     NaN with lines lw 1 dt 2 lc rgb "black" title "exact"

# 出力先を閉じる. これで PNG ファイルへの書き込みが確定する
# (書かないと, 環境によってはファイルが不完全なまま残ることがある)
set output
